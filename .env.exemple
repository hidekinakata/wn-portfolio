# ----------------------------------------------------------------------------
# Copie este arquivo para .env.local e preencha os valores.
#   cp .env.exemple .env.local
# ----------------------------------------------------------------------------

# --- Postgres / Prisma -------------------------------------------------------
# Connection pooling (usado pela aplicacao em runtime).
# No Supabase: Settings > Database > Connection string > URI (Transaction pooler)
DATABASE_URL=

# Direct connection to the database. Used for migrations (Prisma CLI).
# No Supabase: Settings > Database > Connection string > URI (Direct connection)
DIRECT_URL=

# --- Supabase Auth ----------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Nunca exponha no cliente.
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin ------------------------------------------------------------------
# Unico e-mail autorizado a acessar /admin (allowlist).
# Deve corresponder a uma conta confirmada do Supabase Auth com senha definida.
# Crie/gerencie essa conta no painel do Supabase; o site nao oferece cadastro.
ADMIN_EMAIL=

# --- Opcional ---------------------------------------------------------------
# Dominio publico absoluto (usado em sitemap/OG). Ex.: https://wnakata.dev
NEXT_PUBLIC_SITE_URL=
