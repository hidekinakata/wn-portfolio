# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.exemple

# prisma generated client
/src/generated/

# local seed scaffolding (kept out of version control on purpose)
/prisma/seed.ts
/prisma/load-env.ts

# working plan document (kept out of version control on purpose)
/PLAN.md

# vercel
.vercel

# openchamber (estado da ferramenta)
.openchamber/

# typescript
*.tsbuildinfo
next-env.d.ts
