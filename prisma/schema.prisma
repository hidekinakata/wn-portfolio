generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Language {
  pt_BR
  en
}

enum ProjectType {
  personal
  professional
}

model Profile {
  id           String               @id @default(cuid())
  key          String               @unique @default("default")
  name         String
  email        String?
  github       String?
  linkedin     String?
  instagram    String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  translations ProfileTranslation[]
}

model ProfileTranslation {
  id        String   @id @default(cuid())
  profileId String
  language  Language
  bio       String?  @db.Text
  cvUrl     String?
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, language])
  @@index([language])
}

model Experience {
  id           String                  @id @default(cuid())
  company      String
  startDate    DateTime
  endDate      DateTime?
  current      Boolean                 @default(false)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  translations ExperienceTranslation[]

  @@index([startDate(sort: Desc)])
}

model ExperienceTranslation {
  id           String     @id @default(cuid())
  experienceId String
  language     Language
  position     String
  description  String?    @db.Text
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@unique([experienceId, language])
  @@index([language])
}

model Education {
  id           String                  @id @default(cuid())
  institution  String
  startDate    DateTime
  endDate      DateTime?
  current      Boolean                 @default(false)
  sortOrder    Int                     @default(0)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  translations EducationTranslation[]

  @@index([sortOrder])
  @@index([startDate(sort: Desc)])
}

model EducationTranslation {
  id          String    @id @default(cuid())
  educationId String
  language    Language
  degree      String
  description String?   @db.Text
  education   Education @relation(fields: [educationId], references: [id], onDelete: Cascade)

  @@unique([educationId, language])
  @@index([language])
}

model Certification {
  id        String    @id @default(cuid())
  name      String
  issuer    String
  url       String?
  issuedAt  DateTime?
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([sortOrder])
  @@index([issuedAt(sort: Desc)])
}

model LanguageProficiency {
  id           String                           @id @default(cuid())
  levelKey     LanguageLevel
  sortOrder    Int                              @default(0)
  createdAt    DateTime                         @default(now())
  updatedAt    DateTime                         @updatedAt
  translations LanguageProficiencyTranslation[]

  @@index([sortOrder])
}

enum LanguageLevel {
  native
  advanced
  intermediate
  basic
}

model LanguageProficiencyTranslation {
  id                    String             @id @default(cuid())
  languageProficiencyId String
  language              Language
  name                  String
  languageProficiency   LanguageProficiency @relation(fields: [languageProficiencyId], references: [id], onDelete: Cascade)

  @@unique([languageProficiencyId, language])
  @@index([language])
}

model Tag {
  id       String       @id @default(cuid())
  name     String
  slug     String       @unique
  projects ProjectTag[]
  articles ArticleTag[]
}

model ProjectTag {
  projectId String
  tagId     String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([projectId, tagId])
}

model Project {
  id           String               @id @default(cuid())
  slug         String?              @unique
  type         ProjectType          @default(personal)
  imageUrl     String?
  link         String?
  github       String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  tags         ProjectTag[]
  translations ProjectTranslation[]

  @@index([createdAt(sort: Desc)])
  @@index([type])
}

model ProjectTranslation {
  id          String      @id @default(cuid())
  projectId   String
  language    Language
  title       String
  description String?     @db.Text
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, language])
  @@index([language])
}

model ArticleTag {
  articleId String
  tagId     String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
}

model Article {
  id           String               @id @default(cuid())
  slug         String               @unique
  number       String
  icon         String               @default("file-text")
  readTime     String
  relatedSlugs String[]
  published    Boolean              @default(false)
  publishedAt  DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  tags         ArticleTag[]
  translations ArticleTranslation[]

  @@index([publishedAt(sort: Desc)])
  @@index([published])
}

model ArticleTranslation {
  id        String   @id @default(cuid())
  articleId String
  language  Language
  title     String
  intro     String   @db.Text
  sections  Json
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, language])
  @@index([language])
}
